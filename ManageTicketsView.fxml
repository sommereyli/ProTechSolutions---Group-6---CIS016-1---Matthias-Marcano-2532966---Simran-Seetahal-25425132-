<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cts.protechsolutionsjavafxapp.ManageTicketsController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="180.0" spacing="20.0" style="-fx-background-color: #D3D3D3; -fx-border-color: #BDC3C7; -fx-border-width: 0 2 0 0;" BorderPane.alignment="CENTER">
            <children>
                <Label text="ProTechSolutions" textFill="#2c3e50">
                    <font><Font name="System Bold" size="18.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleNavDashboard" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: transparent; -fx-border-color: #2980B9; -fx-border-width: 2;" text="Dashboard" />
                <Button prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: #ECA4A6; -fx-border-color: #2980B9; -fx-border-width: 2;" text="Manage Tickets">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
                <VBox alignment="BOTTOM_LEFT" VBox.vgrow="ALWAYS">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: transparent; -fx-border-color: #E74C3C; -fx-border-width: 2;" text="Logout" />
                    </children>
                </VBox>
            </children>
            <padding><Insets bottom="20.0" left="10.0" right="10.0" top="30.0" /></padding>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="15.0" style="-fx-background-color: #ECA4A6;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
            <children>
                <Label text="Manage All Tickets" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>

                <!-- Search and Action Bar -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="250.0" promptText="Search by Name or ID..." />
                        <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" text="Search" />
                        <Button mnemonicParsing="false" onAction="#handleLoadAll" prefHeight="35.0" prefWidth="80.0" style="-fx-background-color: #D3D3D3;" text="Refresh" />

                        <!-- Spacer to push Delete to the right -->
                        <HBox HBox.hgrow="ALWAYS" />

                        <Button mnemonicParsing="false" onAction="#handleDelete" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Delete Ticket">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                    </children>
                </HBox>

                <!-- The Data Table -->
                <TableView fx:id="tableTickets" prefHeight="400.0" prefWidth="650.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="100.0" text="Ticket ID" />
                        <TableColumn fx:id="colCustomer" prefWidth="150.0" text="Customer Name" />
                        <TableColumn fx:id="colDevice" prefWidth="150.0" text="Device" />
                        <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
                        <TableColumn fx:id="colCost" prefWidth="100.0" text="Total Cost ($)" />
                    </columns>
                </TableView>

                <Label fx:id="lblMessage" textFill="#2c3e50">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
            </children>
        </VBox>
    </center>
</BorderPane>
